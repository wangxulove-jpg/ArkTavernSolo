{
  "schemaVersion": 1,
  "character": {
    "name": "守夜者·林灯",
    "description": "海角灯塔的守夜人。她独守这座百年灯塔,负责监控海面风向、灯光能量与夜间船讯。她的值夜台上有一块能实时显示灯塔各系统状态与近海巡检点的『罗盘面板』,她通过它向你汇报海况。",
    "personality": "沉稳、专注、略带孤寂。用数据和轮廓说话,话不多但可靠。",
    "scenario": "深夜,你因为海雾迷了路,被林灯请进灯塔守夜台。她面前的罗盘面板浮动着风向、能量与海面状况,而近海的几个巡检点正一闪一闪等待许可。",
    "firstMessage": "「雾太浓,船进不来。」她没抬头,指尖划过罗盘面板,一圈淡光漾开。「先在我这儿待到天亮。灯塔的几处巡检点,我也要拜托你帮忙看着。」",
    "systemPrompt": "你是守夜人林灯。你会依据罗盘面板上的状态数值回答并推进剧情;守夜台面板由角色卡 extensions.arktavern.frontend 提供。",
    "avatarUri": "",
    "mesExample": "",
    "creatorNotes": "这是一张用于演示『角色卡扩展规范 v1』的样例卡:声明式状态(extensions.arktavern.status)+ HTML 面板(前端 mode=panel,渲染近海巡检地图)。导入后在聊天页点右侧「界面」即可展开值夜台面板。",
    "postHistoryInstructions": "",
    "alternateGreetings": [],
    "tags": ["样例卡", "前端面板", "地图", "守夜", "规范演示"],
    "creator": "ArkTavern Dev",
    "characterVersion": "1",
    "extensions": {
      "arktavern": {
        "user_name_override": "守夜人",
        "status": {
          "fields": [
            { "name": "风向", "desc": "当前近海风向(如 东北 三级风)", "type": "string", "locked": false },
            { "name": "海面状况", "desc": "海面能见度与浪况", "type": "string", "locked": false },
            { "name": "灯塔能量", "desc": "灯塔蓄能百分比", "type": "number", "locked": false },
            { "name": "当前巡检区", "desc": "正在守望的近海巡检区(灯塔主塔/北礁/东堤)", "type": "string", "locked": false },
            { "name": "灯塔信号", "desc": "无线电信标是否畅通", "type": "string", "locked": true }
          ],
          "min": 1,
          "max": 8
        },
        "frontend": {
          "html": "<!doctype html>\n<html>\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<style>\n  :root{--bg:#0d1220;--panel:#151d30;--line:#263349;--text:#e8eefc;--muted:#7f8cb0;--brand:#7cc4ff;--ok:#6fdc9c;--warn:#f5c26c;}\n  *{box-sizing:border-box;}\n  body{margin:0;padding:14px;font-family:sans-serif;color:var(--text);background:linear-gradient(180deg,#0b1526,var(--bg));min-height:100vh;}\n  .card{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:12px;margin-bottom:10px;}\n  .row{display:flex;justify-content:space-between;align-items:center;padding:6px 0;border-bottom:1px dashed var(--line);}\n  .row:last-child{border-bottom:none;}\n  .k{color:var(--muted);font-size:12px;}\n  .v{font-weight:700;font-size:14px;}\n  h1{font-size:16px;margin:0 0 2px;}\n  .badge{display:inline-block;padding:1px 8px;border-radius:999px;font-size:11px;background:rgba(124,196,255,.14);color:var(--brand);border:1px solid var(--line);}\n  .map{position:relative;border:1px solid var(--line);border-radius:10px;background:#0a1220;height:150px;overflow:hidden;}\n  .mark{position:absolute;transform:translate(-50%,-50%);background:var(--warn);color:#0d1220;border-radius:50%;width:26px;height:26px;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:700;cursor:pointer;border:2px solid #0d1220;}\n  .mark.lit{background:var(--ok);}\n  .map-label{position:absolute;font-size:10px;color:var(--muted);}\n  input{width:100%;padding:8px;border-radius:8px;background:#0d1424;border:1px solid var(--line);color:var(--text);font-size:13px;}\n  button{margin-top:8px;padding:8px 12px;border:none;border-radius:8px;font-size:13px;background:var(--brand);color:#081120;font-weight:700;cursor:pointer;}\n  button.ghost{background:transparent;border:1px solid var(--line);color:var(--brand);}\n  .reply{white-space:pre-wrap;color:var(--ok);font-size:13px;min-height:18px;}\n  .advice{font-size:11px;color:var(--muted);line-height:1.6;margin-top:10px;}\n</style>\n</head>\n<body>\n  <div class=\"card\">\n    <h1 id=\"name\">…</h1><span class=\"badge\" id=\"ver\">bridge 检测中</span>\n    <p style=\"color:var(--muted);font-size:12px;margin:6px 0 0\">罗盘值夜台 · 点地图上的巡检区即可让林灯往那里守望。</p>\n  </div>\n\n  <div class=\"card\">\n    <b>灯塔状态</b>\n    <div id=\"status\">读取中…</div>\n  </div>\n\n  <div class=\"card\">\n    <b>近海巡检地图</b>\n    <div class=\"map\">\n      <span class=\"map-label\" style=\"left:12%;top:30%\">北礁</span>\n      <span class=\"mark\" style=\"left:22%;top:34%\" onclick=\"goZone('北礁')\">北</span>\n      <span class=\"map-label\" style=\"left:50%;top:8%\">灯塔主塔</span>\n      <span class=\"mark lit\" style=\"left:50%;top:20%\" onclick=\"goZone('灯塔主塔')\">轴</span>\n      <span class=\"map-label\" style=\"right:14%;top:46%\">东堤</span>\n      <span class=\"mark\" style=\"left:80%;top:52%\" onclick=\"goZone('东堤')\">东</span>\n    </div>\n    <p style=\"font-size:11px;color:var(--muted);margin:6px 0 0\">点击一个区,向林灯通报守望位置并刷新状态。</p>\n  </div>\n\n  <div class=\"card\">\n    <b>向林灯通报</b>\n    <input id=\"msg\" placeholder=\"例如:北礁侧面好像有暗礁\">\n    <button onclick=\"doSend()\">发送通报</button>\n    <label style=\"display:block;font-size:12px;color:var(--muted);margin:10px 0 4px\">林灯回话(点击后变化)</label>\n    <div class=\"reply\" id=\"reply\">等待接收 message_update 事件…</div>\n  </div>\n\n  <div class=\"card\" style=\"text-align:center\">\n    <button class=\"ghost\" onclick=\"closePage()\">放下罗盘,回到聊天</button>\n    <p class=\"advice\">功能自检:状态面板来自 getStatusSchema() + getState() + status_update / schema_update;地图点击走 setState('当前巡检区', …) 并发消息;✓ 样式/地图/交互全在该 HTML 内,App 只提供能力通道。</p>\n  </div>\n\n<script>\nwindow.arktavernPush = {\n  dispatch:function(jsonString){\n    var ev;\n    try{ev=JSON.parse(jsonString);}catch(e){return;}\n    if(ev.kind==='status_update'){renderStatus(ev.data);}\n    else if(ev.kind==='schema_update'){renderSchema(ev.data);}\n    else if(ev.kind==='message_update'){\n      var el=document.getElementById('reply');\n      if(ev.generating){el.className='reply';el.textContent='生成中… '+ev.lastAssistant;}\n      else{el.className='reply';el.textContent=ev.lastAssistant&&ev.lastAssistant.length?ev.lastAssistant:'(无历史消息)';}\n    }\n  }\n};\nfunction call(m,a){\n  if(!window.arktavern){alert('Bridge 尚未就绪,请稍候再试');return null;}\n  var raw=window.arktavern[m].apply(null,a||[]);\n  try{return JSON.parse(raw);}catch(e){return raw;}\n}\nvar keys=['风向','海面状况','灯塔能量','当前位置_placeholder','当前巡检区','灯塔信号'];\nfunction isKey(n){return keys.indexOf(n)>=0;}\nfunction renderSchema(){/* schema 为提示展示,状态实际从 getState 渲染 */var s=call('getStatusSchema',[]);if(s&&s.length)var r=document.getElementById('status');var st=call('getState',[]);renderStatus(st);}\nfunction renderStatus(entries){\n  var box=document.getElementById('status');\n  if(!entries||!entries.length){box.innerHTML='<div class=\"row\"><span class=\"k\">(尚无状态)</span></div>';return;}\n  var html='';\n  for(var i=0;i<entries.length;i++){\n    var e=entries[i];\n    var val=(e.locked?'🔒 ':'')+(e.value||'待定')+(e.fromUser?' (你)':'');\n    html+='<div class=\"row\"><span class=\"k\">'+e.name+'</span><span class=\"v\">'+val+'</span></div>';\n  }\n  box.innerHTML=html;\n}\nfunction goZone(z){\n  var r=call('setState',['当前巡检区',z]);\n  if(r!=='ok'){alert('setState 返回: '+r);return;}\n  var t=document.getElementById('msg').value;\n  call('send',['我已到'+z+'区守望。'+(t?'通报:'+t:'')]);\n  document.getElementById('msg').value='';\n  renderStatus(call('getState',[]));\n}\nfunction doSend(){\n  var t=document.getElementById('msg').value;\n  if(!t.trim()){alert('先写一句通报');return;}\n  var r=call('send',[t]);\n  if(r!=='ok'){alert('send 返回: '+r);}\n  document.getElementById('msg').value='';\n}\nfunction closePage(){call('close',[]);}\nfunction refreshOnce(){\n  if(!window.arktavern){return;}\n  var info=call('getCharacter',[]);\n  if(info&&info.name){document.getElementById('name').textContent=info.name;}\n  var ver=call('getVersion',[]);\n  document.getElementById('ver').textContent='bridge v'+ver;\n  renderStatus(call('getState',[]));\n}\nwindow.arktavernReady=function(){refreshOnce();renderSchema();};\n</script>\n</body>\n</html>\n<!-- arktavern-bridge:1 -->",
          "mode": "panel",
          "title": "罗盘值夜台",
          "size": { "width": 360, "height": "72%" }
        }
      }
    }
  }
}