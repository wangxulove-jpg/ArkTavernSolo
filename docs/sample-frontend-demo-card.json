{
  "schemaVersion": 1,
  "character": {
    "name": "阿澈 · 炼金术士",
    "description": "主城深处的年轻炼金术士,能用瓶瓶罐罐里的物质追踪你的冒险。她拥有一块能实时显示当前世界状态的炼金石版面,所有数值都刻在这块『模拟界面』上。",
    "personality": "冷静、缜密、略带好奇。喜欢用精准的数值说话,不喜欢含糊其辞。",
    "scenario": "你推开炼金工房的门,阿澈正盯着面前悬浮的炼金石界面,石面上滚动着金币、药材、炼金飞狮等数值。",
    "firstMessage": "「你来得正好。」阿澈没有抬头,指尖划过悬浮界面,上面的数字跳了跳。「这块炼金石现在会说话——我把它接上了你的通讯回路。你要看看上面的东西吗?」",
    "systemPrompt": "你是炼金术士阿澈。你会观察炼金石界面上的状态数值,并依据它们推进对话。你可以通过界面新增或修改状态字段。",
    "avatarUri": "",
    "mesExample": "",
    "creatorNotes": "这是一张用于验证『前端页面角色卡』功能的测试卡。界面字段通过 extensions.arktavern.frontend 提供。",
    "postHistoryInstructions": "",
    "alternateGreetings": [],
    "tags": ["测试卡", "前端界面", "炼金"],
    "creator": "ArkTavern Dev",
    "characterVersion": "1",
    "extensions": {
      "arktavern": {
        "user_name_override": "冒险者",
        "status": {
          "fields": [
            { "name": "金币", "desc": "当前持有金币数", "type": "number", "locked": false },
            { "name": "药材", "desc": "破解药剂所需的主要药材", "type": "string", "locked": false },
            { "name": "炼金飞狮", "desc": "驯养飞狮的忠诚度", "type": "string", "locked": false },
            { "name": "炼金石联动", "desc": "炼金石界面与冒险者通讯回路的连接状态", "type": "string", "locked": true }
          ],
          "min": 1,
          "max": 8
        },
        "frontend": {
        "html": "<!doctype html>\n<html>\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<style>\n  :root {\n    --bg: #17131f; --panel: #241d30; --line: #3a2f4d;\n    --text: #eee6f5; --muted: #9c8fb0; --brand: #a78bff;\n    --ok: #6fdc9c; --warn: #f5c26c;\n  }\n  * { box-sizing: border-box; }\n  body {\n    margin: 0; padding: 16px; font-family: sans-serif; color: var(--text);\n    background: linear-gradient(180deg, #1d1730, var(--bg)); min-height: 100vh;\n  }\n  .card {\n    background: var(--panel); border: 1px solid var(--line); border-radius: 14px;\n    padding: 14px; margin-bottom: 14px;\n  }\n  .row { display: flex; justify-content: space-between; align-items: center; padding: 8px 0; border-bottom: 1px dashed var(--line); }\n  .row:last-child { border-bottom: none; }\n  .k { color: var(--muted); font-size: 13px; }\n  .v { font-weight: 700; }\n  h1 { font-size: 18px; margin: 0 0 4px; }\n  .badge {\n    display: inline-block; padding: 2px 8px; border-radius: 999px; font-size: 12px;\n    background: rgba(167,139,255,.15); color: var(--brand); border: 1px solid var(--line);\n  }\n  .field { width: 100%; margin-top: 10px; }\n  label { font-size: 12px; color: var(--muted); display: block; margin: 10px 0 4px; }\n  input, select {\n    width: 100%; padding: 9px; border-radius: 9px; background: #1a1526;\n    border: 1px solid var(--line); color: var(--text); font-size: 14px;\n  }\n  button {\n    margin-top: 10px; padding: 10px 14px; border: none; border-radius: 9px; font-size: 14px;\n    background: var(--brand); color: #140f20; font-weight: 700; cursor: pointer;\n  }\n  button.ghost { background: transparent; border: 1px solid var(--line); color: var(--brand); }\n  button.small { padding: 4px 9px; font-size: 12px; margin: 0 0 0 8px; }\n  .reply { white-space: pre-wrap; color: var(--ok); font-size: 14px; min-height: 20px; }\n  .generating { color: var(--warn); }\n  .advice { font-size: 12px; color: var(--muted); line-height: 1.6; margin-top: 12px; }\n  .btnrow { display: flex; gap: 8px; }\n</style>\n</head>\n<body>\n  <div class=\"card\">\n    <h1 id=\"name\">…</h1>\n    <span class=\"badge\" id=\"ver\">bridge 检测中</span>\n    <p style=\"color:var(--muted);font-size:13px\">这块炼金石界面默认处于『只读』。点下方按钮即可修改状态、发消息。</p>\n  </div>\n\n  <div class=\"card\">\n    <div style=\"display:flex;justify-content:space-between;align-items:center\">\n      <b>角色状态</b>\n      <button class=\"small ghost\" onclick=\"randomize()\">随机刷新</button>\n    </div>\n    <div id=\"status\">读取中…</div>\n  </div>\n\n  <div class=\"card\">\n    <b>新增 / 修改状态</b>\n    <label>字段名</label>\n    <input id=\"sk\" placeholder=\"例如 金币 / 好感度 / 药材\">\n    <label>数值(留空 = 删除该字段)</label>\n    <input id=\"sv\" placeholder=\"例如 1250\">\n    <button onclick=\"setField()\">写入状态</button>\n  </div>\n\n  <div class=\"card\">\n    <b>向阿澈发消息</b>\n    <input id=\"msg\" placeholder=\"例如:帮我看下现在有多少金币\">\n    <button onclick=\"doSend()\">发送</button>\n    <label>阿澈的回话(点击后变化)</label>\n    <div class=\"reply\" id=\"reply\">等待接收 message_update 事件…</div>\n  </div>\n\n  <div class=\"card\" style=\"text-align:center\">\n    <button class=\"ghost\" onclick=\"closePage()\">关闭界面,返回聊天</button>\n    <p class=\"advice\">\n      功能自检:① 顶部显示角色名,来自 getCharacter();② 版本徽标来自 getVersion();\n      ③ 状态面板来自 getState() + status_update;④ 写入状态走 setState();\n      ⑤ 发消息走 send(),回话走 message_update。\n    </p>\n  </div>\n\n<script>\n// ===== 1. 事件入口必须先注册 =====\nwindow.arktavernPush = {\n  dispatch: function (jsonString) {\n    var ev;\n    try { ev = JSON.parse(jsonString); } catch (e) { return; }\n    if (ev.kind === 'status_update') {\n      renderStatus(ev.data);\n    } else if (ev.kind === 'message_update') {\n      var el = document.getElementById('reply');\n      if (ev.generating) {\n        el.className = 'reply generating';\n        el.innerText = '生成中…\\n' + ev.lastAssistant;\n      } else {\n        el.className = 'reply';\n        el.innerText = ev.lastAssistant.length ? ev.lastAssistant : '(无历史消息)';\n      }\n    }\n  }\n};\n\n// ===== 2. 简化的 JSON 获取 =====\nfunction call(method, args) {\n  if (!window.arktavern) { alert('Bridge 尚未就绪,请稍候再试'); return null; }\n  var raw = window.arktavern[method].apply(null, args || []);\n  try { return JSON.parse(raw); } catch (e) { return raw; }\n}\n\nfunction renderStatus(entries) {\n  var box = document.getElementById('status');\n  if (!entries || !entries.length) { box.innerText = '(尚无状态字段)'; return; }\n  var html = '';\n  for (var i = 0; i < entries.length; i++) {\n    var e = entries[i];\n    var val = (e.locked ? '🔒 ' : '') + e.value + (e.fromUser ? ' (你)' : '');\n    html += '<div class=\"row\">' +\n            '<span class=\"k\">' + e.name + '</span>' +\n            '<span class=\"v\">' + val + '</span></div>';\n  }\n  box.innerHTML = html;\n}\n\n// ===== 3. 交互 =====\nfunction doSend() {\n  var t = document.getElementById('msg').value;\n  if (!t.trim()) { alert('先输入一句话'); return; }\n  var r = call('send', [t]);\n  if (r !== 'ok') { alert('send 返回: ' + r); }\n  document.getElementById('msg').value = '';\n}\n\nfunction setField() {\n  var k = document.getElementById('sk').value.trim();\n  if (!k) { alert('字段名不能为空'); return; }\n  var v = document.getElementById('sv').value.trim();\n  var r = call('setState', [k, v]);\n  if (r !== 'ok') { alert('setState 返回: ' + r); }\n}\n\nfunction randomize() {\n  var r = call('setState', ['金币', String((Math.random() * 5000) | 0)]);\n  if (r !== 'ok') { alert('setState 返回: ' + r); }\n}\n\nfunction closePage() {\n  call('close', []);\n}\n\n// ===== 4. 打开即刷新一次状态 =====\nfunction refreshOnce() {\n  if (!window.arktavern) { return; }\n  var info = call('getCharacter', []);\n  if (info && info.name) { document.getElementById('name').innerText = info.name; }\n  var ver = call('getVersion', []);\n  document.getElementById('ver').innerText = 'bridge v' + ver;\n  renderStatus(call('getState', []));\n}\n// bridge 注入完成探针\nwindow.arktavernReady = function () {\n  refreshOnce();\n  call('setState', ['炼金石联动', '已连接']);\n  // 再触发一次状态刷新,保证新增字段立即上屏\n  renderStatus(call('getState', []));\n};\n</script>\n</body>\n</html>\n<!-- arktavern-bridge:1 -->",
        "mode": "panel",
        "title": "炼金石界面",
        "size": { "width": 360, "height": "72%" }
        }
      }
    }
  }
}