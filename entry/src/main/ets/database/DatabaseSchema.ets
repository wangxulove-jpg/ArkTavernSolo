  `${COLUMN_LAST_MESSAGE_AT} INTEGER NOT NULL DEFAULT 0, ` +
  `${COLUMN_IS_ARCHIVED} INTEGER NOT NULL DEFAULT 0, ` +
  `${COLUMN_SORT_ORDER} INTEGER NOT NULL DEFAULT 0, ` +
  `${COLUMN_CHAT_USER_NAME_OVERRIDE} TEXT NOT NULL DEFAULT '', ` +
