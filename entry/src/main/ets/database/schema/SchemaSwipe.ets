/**
 * SchemaSwipe — 数据库 DDL 常量(P3-3② 自 DatabaseSchema 按域拆出,逐字搬出)。
 * 表名/列名/索引名一律来自 DatabaseConstants。
 */

import {
  COLUMN_CHAT_ID,
  COLUMN_CONTENT,
  COLUMN_CREATED_AT,
  COLUMN_ERROR_MESSAGE,
  COLUMN_IS_STREAMING,
  COLUMN_STATUS,
  COLUMN_SWIPE_ACTIVE_CANDIDATE_INDEX,
  COLUMN_SWIPE_ASSISTANT_MESSAGE_ID,
  COLUMN_SWIPE_CANDIDATE_ID,
  COLUMN_SWIPE_CANDIDATE_INDEX,
  COLUMN_UPDATED_AT,
  INDEX_SWIPE_CANDIDATES_MESSAGE_ID,
  INDEX_SWIPE_CANDIDATES_MESSAGE_INDEX,
  INDEX_SWIPE_GROUPS_CHAT_ID,
  TABLE_MESSAGE_SWIPE_CANDIDATES,
  TABLE_MESSAGE_SWIPE_GROUPS
} from '../DatabaseConstants';

// ===== v4: Swipe Tables =====
export const CREATE_MESSAGE_SWIPE_GROUPS_TABLE: string =
  `CREATE TABLE IF NOT EXISTS ${TABLE_MESSAGE_SWIPE_GROUPS} (` +
  `${COLUMN_SWIPE_ASSISTANT_MESSAGE_ID} TEXT PRIMARY KEY NOT NULL, ` +
  `${COLUMN_CHAT_ID} TEXT NOT NULL, ` +
  `${COLUMN_SWIPE_ACTIVE_CANDIDATE_INDEX} INTEGER NOT NULL DEFAULT 0, ` +
  `${COLUMN_CREATED_AT} INTEGER NOT NULL, ` +
  `${COLUMN_UPDATED_AT} INTEGER NOT NULL` +
  `)`;

export const CREATE_MESSAGE_SWIPE_CANDIDATES_TABLE: string =
  `CREATE TABLE IF NOT EXISTS ${TABLE_MESSAGE_SWIPE_CANDIDATES} (` +
  `${COLUMN_SWIPE_CANDIDATE_ID} TEXT PRIMARY KEY NOT NULL, ` +
  `${COLUMN_SWIPE_ASSISTANT_MESSAGE_ID} TEXT NOT NULL, ` +
  `${COLUMN_SWIPE_CANDIDATE_INDEX} INTEGER NOT NULL, ` +
  `${COLUMN_CONTENT} TEXT NOT NULL DEFAULT '', ` +
  `${COLUMN_STATUS} TEXT NOT NULL, ` +
  `${COLUMN_ERROR_MESSAGE} TEXT, ` +
  `${COLUMN_IS_STREAMING} INTEGER NOT NULL DEFAULT 0, ` +
  `${COLUMN_CREATED_AT} INTEGER NOT NULL, ` +
  `${COLUMN_UPDATED_AT} INTEGER` +
  `)`;

export const CREATE_INDEX_SWIPE_GROUPS_CHAT_ID: string =
  `CREATE INDEX IF NOT EXISTS ${INDEX_SWIPE_GROUPS_CHAT_ID} ` +
  `ON ${TABLE_MESSAGE_SWIPE_GROUPS}(${COLUMN_CHAT_ID})`;

export const CREATE_INDEX_SWIPE_CANDIDATES_MESSAGE_ID: string =
  `CREATE INDEX IF NOT EXISTS ${INDEX_SWIPE_CANDIDATES_MESSAGE_ID} ` +
  `ON ${TABLE_MESSAGE_SWIPE_CANDIDATES}(${COLUMN_SWIPE_ASSISTANT_MESSAGE_ID})`;

export const CREATE_UNIQUE_INDEX_SWIPE_CANDIDATES_MESSAGE_INDEX: string =
  `CREATE UNIQUE INDEX IF NOT EXISTS ${INDEX_SWIPE_CANDIDATES_MESSAGE_INDEX} ` +
  `ON ${TABLE_MESSAGE_SWIPE_CANDIDATES}(${COLUMN_SWIPE_ASSISTANT_MESSAGE_ID}, ${COLUMN_SWIPE_CANDIDATE_INDEX})`;
