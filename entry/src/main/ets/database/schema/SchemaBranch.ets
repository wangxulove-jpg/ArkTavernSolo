import {
  COLUMN_ACTIVE_BRANCH_ID,
  COLUMN_BRANCH_ID,
  COLUMN_CANDIDATE_INDEX,
  COLUMN_CHAT_ID,
  COLUMN_CREATED_AT,
  COLUMN_FORK_MESSAGE_ID,
  COLUMN_ID,
  COLUMN_IS_ROOT,
  COLUMN_LAST_MESSAGE_AT,
  COLUMN_NAME,
  COLUMN_PARENT_BRANCH_ID,
  COLUMN_POSITION,
  COLUMN_SWIPE_ASSISTANT_MESSAGE_ID,
  COLUMN_UPDATED_AT,
  INDEX_BRANCH_MESSAGES_MESSAGE_ID,
  INDEX_BRANCH_SWIPE_SELECTIONS_MESSAGE_ID,
  INDEX_CONVERSATION_BRANCHES_CHAT_ID,
  INDEX_CONVERSATION_BRANCHES_PARENT_ID,
  TABLE_CHAT_BRANCH_STATE,
  TABLE_CONVERSATION_BRANCHES,
  TABLE_CONVERSATION_BRANCH_MESSAGES,
  TABLE_CONVERSATION_BRANCH_SWIPE_SELECTIONS
} from '../DatabaseConstants';

// ===== v5: Conversation Branches Tables =====
export const CREATE_CONVERSATION_BRANCHES_TABLE: string =
  `CREATE TABLE IF NOT EXISTS ${TABLE_CONVERSATION_BRANCHES} (` +
  `${COLUMN_ID} TEXT PRIMARY KEY NOT NULL, ` +
  `${COLUMN_CHAT_ID} TEXT NOT NULL, ` +
  `${COLUMN_PARENT_BRANCH_ID} TEXT, ` +
  `${COLUMN_FORK_MESSAGE_ID} TEXT, ` +
  `${COLUMN_NAME} TEXT NOT NULL DEFAULT '', ` +
  `${COLUMN_IS_ROOT} INTEGER NOT NULL DEFAULT 0, ` +
  `${COLUMN_CREATED_AT} INTEGER NOT NULL, ` +
  `${COLUMN_UPDATED_AT} INTEGER NOT NULL, ` +
  `${COLUMN_LAST_MESSAGE_AT} INTEGER NOT NULL` +
  `)`;

export const CREATE_CHAT_BRANCH_STATE_TABLE: string =
  `CREATE TABLE IF NOT EXISTS ${TABLE_CHAT_BRANCH_STATE} (` +
  `${COLUMN_CHAT_ID} TEXT PRIMARY KEY NOT NULL, ` +
  `${COLUMN_ACTIVE_BRANCH_ID} TEXT NOT NULL, ` +
  `${COLUMN_UPDATED_AT} INTEGER NOT NULL` +
  `)`;

export const CREATE_CONVERSATION_BRANCH_MESSAGES_TABLE: string =
  `CREATE TABLE IF NOT EXISTS ${TABLE_CONVERSATION_BRANCH_MESSAGES} (` +
  `${COLUMN_BRANCH_ID} TEXT NOT NULL, ` +
  `${COLUMN_ID} TEXT NOT NULL, ` +
  `${COLUMN_POSITION} INTEGER NOT NULL, ` +
  `${COLUMN_CREATED_AT} INTEGER NOT NULL, ` +
  `PRIMARY KEY (${COLUMN_BRANCH_ID}, ${COLUMN_POSITION}), ` +
  `UNIQUE (${COLUMN_BRANCH_ID}, ${COLUMN_ID})` +
  `)`;

export const CREATE_CONVERSATION_BRANCH_SWIPE_SELECTIONS_TABLE: string =
  `CREATE TABLE IF NOT EXISTS ${TABLE_CONVERSATION_BRANCH_SWIPE_SELECTIONS} (` +
  `${COLUMN_BRANCH_ID} TEXT NOT NULL, ` +
  `${COLUMN_SWIPE_ASSISTANT_MESSAGE_ID} TEXT NOT NULL, ` +
  `${COLUMN_CANDIDATE_INDEX} INTEGER NOT NULL, ` +
  `${COLUMN_UPDATED_AT} INTEGER NOT NULL, ` +
  `PRIMARY KEY (${COLUMN_BRANCH_ID}, ${COLUMN_SWIPE_ASSISTANT_MESSAGE_ID})` +
  `)`;

export const CREATE_INDEX_CONVERSATION_BRANCHES_CHAT_ID: string =
  `CREATE INDEX IF NOT EXISTS ${INDEX_CONVERSATION_BRANCHES_CHAT_ID} ` +
  `ON ${TABLE_CONVERSATION_BRANCHES}(${COLUMN_CHAT_ID})`;

export const CREATE_INDEX_CONVERSATION_BRANCHES_PARENT_ID: string =
  `CREATE INDEX IF NOT EXISTS ${INDEX_CONVERSATION_BRANCHES_PARENT_ID} ` +
  `ON ${TABLE_CONVERSATION_BRANCHES}(${COLUMN_PARENT_BRANCH_ID})`;

export const CREATE_INDEX_BRANCH_MESSAGES_MESSAGE_ID: string =
  `CREATE INDEX IF NOT EXISTS ${INDEX_BRANCH_MESSAGES_MESSAGE_ID} ` +
  `ON ${TABLE_CONVERSATION_BRANCH_MESSAGES}(${COLUMN_ID})`;

export const CREATE_INDEX_BRANCH_SWIPE_SELECTIONS_MESSAGE_ID: string =
  `CREATE INDEX IF NOT EXISTS ${INDEX_BRANCH_SWIPE_SELECTIONS_MESSAGE_ID} ` +
  `ON ${TABLE_CONVERSATION_BRANCH_SWIPE_SELECTIONS}(${COLUMN_SWIPE_ASSISTANT_MESSAGE_ID})`;
