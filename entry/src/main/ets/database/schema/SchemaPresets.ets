/**
 * SchemaPresets — 数据库 DDL 常量(P3-3② 自 DatabaseSchema 按域拆出,逐字搬出)。
 * 表名/列名/索引名一律来自 DatabaseConstants。
 */

import {
  COLUMN_PERSONA_AVATAR_URI,
  COLUMN_PERSONA_CREATED_AT,
  COLUMN_PERSONA_DEPTH,
  COLUMN_PERSONA_DESCRIPTION,
  COLUMN_PERSONA_ID,
  COLUMN_PERSONA_NAME,
  COLUMN_PERSONA_POSITION,
  COLUMN_PERSONA_UPDATED_AT,
  COLUMN_PRESET_CONTEXT_WINDOW,
  COLUMN_PRESET_CREATED_AT,
  COLUMN_PRESET_DESCRIPTION,
  COLUMN_PRESET_ID,
  COLUMN_PRESET_MAX_OUTPUT_TOKENS,
  COLUMN_PRESET_NAME,
  COLUMN_PRESET_SYSTEM_PROMPT,
  COLUMN_PRESET_TEMPERATURE,
  COLUMN_PRESET_TOP_P,
  COLUMN_PRESET_UPDATED_AT,
  INDEX_PERSONAS_UPDATED_AT,
  INDEX_PROMPT_PRESETS_UPDATED_AT,
  TABLE_PERSONAS,
  TABLE_PROMPT_PRESETS
} from '../DatabaseConstants';

// ===== v3: Prompt Presets Table =====
export const CREATE_PROMPT_PRESETS_TABLE: string =
  `CREATE TABLE IF NOT EXISTS ${TABLE_PROMPT_PRESETS} (` +
  `${COLUMN_PRESET_ID} TEXT PRIMARY KEY NOT NULL, ` +
  `${COLUMN_PRESET_NAME} TEXT NOT NULL, ` +
  `${COLUMN_PRESET_DESCRIPTION} TEXT NOT NULL DEFAULT '', ` +
  `${COLUMN_PRESET_SYSTEM_PROMPT} TEXT NOT NULL DEFAULT '', ` +
  `${COLUMN_PRESET_TEMPERATURE} REAL, ` +
  `${COLUMN_PRESET_TOP_P} REAL, ` +
  `${COLUMN_PRESET_MAX_OUTPUT_TOKENS} INTEGER, ` +
  `${COLUMN_PRESET_CONTEXT_WINDOW} INTEGER, ` +
  `${COLUMN_PRESET_CREATED_AT} INTEGER NOT NULL, ` +
  `${COLUMN_PRESET_UPDATED_AT} INTEGER NOT NULL` +
  `)`;

// ===== v3: Prompt Preset Indexes =====
export const CREATE_INDEX_PROMPT_PRESETS_UPDATED_AT: string =
  `CREATE INDEX IF NOT EXISTS ${INDEX_PROMPT_PRESETS_UPDATED_AT} ` +
  `ON ${TABLE_PROMPT_PRESETS}(${COLUMN_PRESET_UPDATED_AT} DESC, ${COLUMN_PRESET_ID} ASC)`;

// ===== v35: Persona 用户身份(Phase 2A) =====

export const CREATE_PERSONAS_TABLE: string =
  `CREATE TABLE IF NOT EXISTS ${TABLE_PERSONAS} (` +
  `${COLUMN_PERSONA_ID} TEXT PRIMARY KEY NOT NULL, ` +
  `${COLUMN_PERSONA_NAME} TEXT NOT NULL, ` +
  `${COLUMN_PERSONA_DESCRIPTION} TEXT NOT NULL DEFAULT '', ` +
  `${COLUMN_PERSONA_AVATAR_URI} TEXT NOT NULL DEFAULT '', ` +
  `${COLUMN_PERSONA_POSITION} INTEGER NOT NULL DEFAULT 1, ` +
  `${COLUMN_PERSONA_DEPTH} INTEGER NOT NULL DEFAULT 4, ` +
  `${COLUMN_PERSONA_CREATED_AT} INTEGER NOT NULL, ` +
  `${COLUMN_PERSONA_UPDATED_AT} INTEGER NOT NULL` +
  `)`;

export const CREATE_INDEX_PERSONAS_UPDATED_AT: string =
  `CREATE INDEX IF NOT EXISTS ${INDEX_PERSONAS_UPDATED_AT} ON ${TABLE_PERSONAS}(${COLUMN_PERSONA_UPDATED_AT})`;
