/**
 * 本地图片库域 DDL(v48 图片表 + v49 分类/关联表(已停用) + v50 描述列)。
 *
 * 与其它 Schema* 文件同口径:表名/列名/索引名只引用 DatabaseConstants,不硬编码字符串。
 * 每批 DDL 同时供 NEW INSTALL 与对应版本迁移使用;**已发布的 DDL 不得改动**。
 */

import {
  COLUMN_CATEGORY_NAME_KEY,
  COLUMN_CHARACTER_ID,
  COLUMN_CREATED_AT,
  COLUMN_ID,
  COLUMN_IMAGE_DESCRIPTION,
  COLUMN_IMAGE_FILE_URI,
  COLUMN_IMAGE_NAME_KEY,
  COLUMN_LINK_CATEGORY_ID,
  COLUMN_LINK_TARGET_ID,
  COLUMN_LINK_TARGET_KIND,
  COLUMN_NAME,
  COLUMN_UPDATED_AT,
  INDEX_LOCAL_IMAGE_CATEGORIES_NAME,
  INDEX_LOCAL_IMAGE_CATEGORY_LINKS_TARGET,
  INDEX_LOCAL_IMAGE_CATEGORY_LINKS_UNIQUE,
  INDEX_LOCAL_IMAGES_CHARACTER,
  INDEX_LOCAL_IMAGES_OWNER_NAME,
  TABLE_LOCAL_IMAGE_CATEGORIES,
  TABLE_LOCAL_IMAGE_CATEGORY_LINKS,
  TABLE_LOCAL_IMAGES
} from '../DatabaseConstants';

/**
 * 本地图片表。
 * - character_id = '' 表示全局图片库;非空表示该角色卡专属
 * - name_key 为归一化名字(trim + 小写)
 */
export const CREATE_LOCAL_IMAGES_TABLE: string =
  `CREATE TABLE IF NOT EXISTS ${TABLE_LOCAL_IMAGES} (` +
  `${COLUMN_ID} TEXT PRIMARY KEY NOT NULL, ` +
  `${COLUMN_NAME} TEXT NOT NULL, ` +
  `${COLUMN_IMAGE_NAME_KEY} TEXT NOT NULL, ` +
  `${COLUMN_IMAGE_FILE_URI} TEXT NOT NULL, ` +
  `${COLUMN_CHARACTER_ID} TEXT NOT NULL DEFAULT '', ` +
  `${COLUMN_CREATED_AT} INTEGER NOT NULL, ` +
  `${COLUMN_UPDATED_AT} INTEGER NOT NULL)`;

/**
 * 同一作用域内名字唯一:
 * 全局库(character_id='')内不可重名;单角色专属库内不可重名;跨作用域允许同名。
 */
export const CREATE_INDEX_LOCAL_IMAGES_OWNER_NAME: string =
  `CREATE UNIQUE INDEX IF NOT EXISTS ${INDEX_LOCAL_IMAGES_OWNER_NAME} ` +
  `ON ${TABLE_LOCAL_IMAGES}(${COLUMN_CHARACTER_ID}, ${COLUMN_IMAGE_NAME_KEY})`;

/** 按作用域查询(全局 / 某角色) */
export const CREATE_INDEX_LOCAL_IMAGES_CHARACTER: string =
  `CREATE INDEX IF NOT EXISTS ${INDEX_LOCAL_IMAGES_CHARACTER} ` +
  `ON ${TABLE_LOCAL_IMAGES}(${COLUMN_CHARACTER_ID})`;

/** v48 新增 DDL 语句(新安装与迁移共用) */
export const V48_NEW_DDL_STATEMENTS: string[] = [
  CREATE_LOCAL_IMAGES_TABLE,
  CREATE_INDEX_LOCAL_IMAGES_OWNER_NAME,
  CREATE_INDEX_LOCAL_IMAGES_CHARACTER
];

// ===== v49: 本地图片库自定义分类(分类可绑多张角色卡;一张图可挂多个分类) =====

/**
 * 分类表。
 * name_key 为归一化分类名(trim + 小写),全局唯一;分类名只用于展示与清单标题(不进 arkimg 语法)。
 */
export const CREATE_LOCAL_IMAGE_CATEGORIES_TABLE: string =
  `CREATE TABLE IF NOT EXISTS ${TABLE_LOCAL_IMAGE_CATEGORIES} (` +
  `${COLUMN_ID} TEXT PRIMARY KEY NOT NULL, ` +
  `${COLUMN_NAME} TEXT NOT NULL, ` +
  `${COLUMN_CATEGORY_NAME_KEY} TEXT NOT NULL, ` +
  `${COLUMN_CREATED_AT} INTEGER NOT NULL, ` +
  `${COLUMN_UPDATED_AT} INTEGER NOT NULL)`;

/** 分类名全局唯一 */
export const CREATE_INDEX_LOCAL_IMAGE_CATEGORIES_NAME: string =
  `CREATE UNIQUE INDEX IF NOT EXISTS ${INDEX_LOCAL_IMAGE_CATEGORIES_NAME} ` +
  `ON ${TABLE_LOCAL_IMAGE_CATEGORIES}(${COLUMN_CATEGORY_NAME_KEY})`;

/**
 * 分类关联表(多态):
 * - target_kind = 'image'     → 分类 ↔ 图片(一张图可挂多个分类)
 * - target_kind = 'character' → 分类 ↔ 角色卡(一个分类可绑多张角色卡)
 * 两种关系共用一张表,三向查询(按分类 / 按图片 / 按角色)都走索引。
 */
export const CREATE_LOCAL_IMAGE_CATEGORY_LINKS_TABLE: string =
  `CREATE TABLE IF NOT EXISTS ${TABLE_LOCAL_IMAGE_CATEGORY_LINKS} (` +
  `${COLUMN_LINK_CATEGORY_ID} TEXT NOT NULL, ` +
  `${COLUMN_LINK_TARGET_KIND} TEXT NOT NULL, ` +
  `${COLUMN_LINK_TARGET_ID} TEXT NOT NULL, ` +
  `${COLUMN_CREATED_AT} INTEGER NOT NULL)`;

/** 分类内同一目标唯一 */
export const CREATE_UNIQUE_INDEX_LOCAL_IMAGE_CATEGORY_LINKS: string =
  `CREATE UNIQUE INDEX IF NOT EXISTS ${INDEX_LOCAL_IMAGE_CATEGORY_LINKS_UNIQUE} ` +
  `ON ${TABLE_LOCAL_IMAGE_CATEGORY_LINKS}(${COLUMN_LINK_CATEGORY_ID}, ${COLUMN_LINK_TARGET_KIND}, ${COLUMN_LINK_TARGET_ID})`;

/** 反向查询索引:某图片挂了哪些分类 / 某角色命中了哪些分类 */
export const CREATE_INDEX_LOCAL_IMAGE_CATEGORY_LINKS_TARGET: string =
  `CREATE INDEX IF NOT EXISTS ${INDEX_LOCAL_IMAGE_CATEGORY_LINKS_TARGET} ` +
  `ON ${TABLE_LOCAL_IMAGE_CATEGORY_LINKS}(${COLUMN_LINK_TARGET_KIND}, ${COLUMN_LINK_TARGET_ID})`;

/** v49 新增 DDL 语句(新安装与迁移共用) */
export const V49_NEW_DDL_STATEMENTS: string[] = [
  CREATE_LOCAL_IMAGE_CATEGORIES_TABLE,
  CREATE_INDEX_LOCAL_IMAGE_CATEGORIES_NAME,
  CREATE_LOCAL_IMAGE_CATEGORY_LINKS_TABLE,
  CREATE_UNIQUE_INDEX_LOCAL_IMAGE_CATEGORY_LINKS,
  CREATE_INDEX_LOCAL_IMAGE_CATEGORY_LINKS_TARGET
];

// ===== v50: 图片池模型(给 local_images 补描述列) =====

/**
 * v49→v50:仅给 local_images 补一列 description(给模型看的图片描述,可空)。
 * 说明:
 * - **不并入 v48 的 `CREATE_LOCAL_IMAGES_TABLE`** —— 已发布的 DDL 不得改动(会让"逐版逐字节一致"失效);
 *   新装走 "v48 建表 → v50 ALTER" 的链,与旧库升级同路。
 * - character_id 自 v50 起停用(列保留),故**无数据迁移**。
 */
export const ALTER_LOCAL_IMAGES_ADD_DESCRIPTION: string =
  `ALTER TABLE ${TABLE_LOCAL_IMAGES} ADD COLUMN ${COLUMN_IMAGE_DESCRIPTION} TEXT NOT NULL DEFAULT ''`;

/** v50 新增 DDL 语句(新安装与迁移共用) */
export const V50_NEW_DDL_STATEMENTS: string[] = [
  ALTER_LOCAL_IMAGES_ADD_DESCRIPTION
];