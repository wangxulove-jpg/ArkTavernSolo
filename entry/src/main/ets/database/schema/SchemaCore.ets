  `PRIMARY KEY (${COLUMN_CHAT_ID}, ${COLUMN_CHARACTER_ID}), ` +
  `UNIQUE (${COLUMN_CHAT_ID}, ${COLUMN_SPEAKER_ORDER})` +
  `)`;

