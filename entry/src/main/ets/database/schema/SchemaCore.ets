export const CREATE_CHAT_PARTICIPANTS_TABLE: string =
  `CREATE TABLE IF NOT EXISTS ${TABLE_CHAT_PARTICIPANTS} (` +
  `${COLUMN_CHAT_ID} TEXT NOT NULL, ` +
  `${COLUMN_CHARACTER_ID} TEXT NOT NULL, ` +
  `${COLUMN_SPEAKER_ORDER} INTEGER NOT NULL, ` +
  `${COLUMN_IS_ENABLED} INTEGER NOT NULL DEFAULT 1, ` +
